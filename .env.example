# Copy to .env (gitignored). Loaded by direnv via dotenv_if_exists.

# OpenRouteService key for walking-route optimization. Free key at
# https://openrouteservice.org — leave blank to use the built-in
# nearest-neighbor fallback (approximate straight-line routes, no account).
ORS_API_KEY=

# Service base URLs. HeiGIT splits the public API per service: directions
# under /openrouteservice, Vroom optimization under /vroom. Self-hosting a
# classic ORS instance? Point both at the same base.
ORS_URL=https://api.heigit.org/openrouteservice
ORS_OPTIMIZATION_URL=https://api.heigit.org/vroom/v0

# Per-IP rate limit for the public API (unused until deployment).
RATE_LIMIT=60/minute

# Upper bound on rows accepted per uploaded CSV.
MAX_UPLOAD_ROWS=5000

# Where saved rounds are stored. LEAVE BLANK for a public deployment: with no
# directory configured the /api/rounds endpoints 404 and the engine stores
# nothing at all, which is the promise the README and DESIGN.md make.
#
# Setting it opts into the private profile — saved rounds carry addresses and
# resident names so a phone can show them on the round (see rounds.py). Only
# set this on an instance behind an access gate.
KRANTENWIJK_ROUNDS_DIR=
