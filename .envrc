# Load the nix devShell (Python 3.13 + uv, Node + pnpm) on entry.
use flake

# Load ORS_API_KEY etc. from .env if present (never committed).
dotenv_if_exists

# Activate the uv-managed venv so `python`/`pytest`/`krantenwijk` work directly.
# Created by `uv sync` in engine/; run `direnv reload` after the first sync.
[ -d engine/.venv ] && source engine/.venv/bin/activate
